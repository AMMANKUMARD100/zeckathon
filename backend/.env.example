# FinPilot AI Environment Variables Example
# Copy to .env and provide your credentials (if using external LLM)

ENVIRONMENT=development
DEBUG=True
DATABASE_URL=sqlite:///./finpilot.db

# LLM Provider configuration: gemini, openai, or local_fallback
LLM_PROVIDER=local_fallback
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL_NAME=gemini-1.5-flash

# Document paths
UPLOAD_DIR=./uploads
SAMPLE_DATA_DIR=./sample_data
